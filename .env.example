# Copy to .env. docker compose sets DATABASE_URL / REDIS_URL itself; these are for running locally.
DATABASE_URL=postgresql+psycopg://osu:osu@localhost:5432/osu_coach
REDIS_URL=redis://localhost:6379/0

# osu! account settings -> OAuth -> New application (used from Day 2)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
